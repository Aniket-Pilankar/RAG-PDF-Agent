generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pdf {
  id         String   @id @default(uuid())
  userId     String
  filename   String
  filePath   String
  status     String   @default("processing")
  uploadedAt DateTime @default(now())
}
