generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pdf {
  id         String   @id @default(uuid())
  userId     String
  filename   String
  filePath   String
  status     String   @default("processing")
  uploadedAt DateTime @default(now())

  // GET /pdfs — filters on userId, orders by uploadedAt desc
  @@index([userId, uploadedAt])
}

model ChatSession {
  id        String    @id @default(uuid())
  userId    String
  title     String    @default("New Chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  // GET /chat/sessions — filters on userId, orders by updatedAt desc
  @@index([userId, updatedAt])
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // GET /chat/sessions/:id/messages — filters on sessionId, orders by createdAt asc.
  // The foreign key alone does NOT create this; Postgres indexes the primary-key
  // side automatically, but not the referencing side.
  @@index([sessionId, createdAt])
}
