# Copy to .env and fill in real values:  cp .env.example .env

# OpenAI — used for both embeddings (text-embedding-3-small)
# and chat completions (gpt-4o-mini).
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres. These defaults match the postgres service in docker-compose.yml,
# so they work as-is for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdf_agent_rag

# Clerk — from the API Keys page of your Clerk application dashboard.
# Must belong to the SAME Clerk application as the client's keys,
# or every authenticated request fails with 401.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
