# Copy to .env.local and fill in real values:  cp .env.example .env.local

# Clerk — from the API Keys page of your Clerk application dashboard.
# Must belong to the SAME Clerk application as the server's keys,
# or every authenticated request fails with 401.
#
# NEXT_PUBLIC_ is required on the publishable key: Next.js only exposes
# variables with that prefix to browser code, and Clerk's React components
# need it client-side. The secret key stays server-side only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
